# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public URL — only used for OG image absolute paths. Derives from the
# request host if unset.
APP_URL=

# ---------------------------------------------------------------------------
# Supabase (DB + Realtime)  — required
# ---------------------------------------------------------------------------
# Pooled connection URI — port 6543 on Supabase.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Ranking provider — choose one server-side path. The frontend is unchanged.
# ---------------------------------------------------------------------------
RANKING_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# auto | mock | real. In auto mode, the selected provider runs when its key
# is present; otherwise the deterministic mock is used.
AGENT_MODE=auto

# ---------------------------------------------------------------------------
# GitHub — required
# ---------------------------------------------------------------------------
# Fine-grained PAT with public-repo read-only is enough. Anonymous limit is
# 60/hr; we burn ~25 calls per rating, so a token is effectively mandatory.
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Upstash Redis — optional (rate limits). Without these, limits are disabled.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile — optional (bot check, enable before public launch)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
